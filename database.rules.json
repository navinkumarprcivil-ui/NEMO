{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "$id": {
        "stockCount": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val())",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "guides":   { ".read": true, ".write": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'" },
    "settings": { ".read": true, ".write": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'" },
    "media":    { ".read": true, ".write": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'" },

    "reviews": {
      ".read": true,
      "$pid": {
        ".write": "auth != null"
      }
    },

    "orders": {
      ".read": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')"
      }
    },

    "favorites": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "interest": {
      ".read": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "$pid": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "requests": {
      ".read": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "$id": {
        ".write": "auth != null && (!data.exists() || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')"
      }
    },

    "showcase": {
      ".read": true,
      "$id": {
        ".write": "auth != null && ( !data.exists() || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || auth.uid === data.child('userUid').val() || (data.child('expiresAt').isNumber() && data.child('expiresAt').val() < now) )"
      }
    },

    "analytics": {
      ".read": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "total": { ".write": "auth != null", ".validate": "newData.isNumber()" },
      "daily": { "$d": { ".write": "auth != null", ".validate": "newData.isNumber()" } }
    },

    "loyalty": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "restock": {
      ".read": "auth != null && auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'",
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "__ping": { ".read": true, ".write": "auth != null" }
  }
}
