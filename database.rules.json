{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$id": {
        "stockCount": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val())",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "variantStock": {
          "$vid": {
            ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val())",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },

    "guides":   { ".read": true, ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')" },
    "settings": { ".read": true, ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')" },
    "media":    { ".read": true, ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')" },

    "settingsPrivate": {
      ".read":  "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')"
    },

    "settingsBank": {
      ".read":  "auth != null",
      ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')"
    },

    "purchases": {
      ".read":  "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$entry": {
        ".validate": "newData.hasChildren(['supplierName','invoiceNo','invoiceDate'])",
        "supplierName":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "supplierGstin":  { ".validate": "newData.isString() && newData.val().length <= 15" },
        "invoiceNo":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "invoiceDate":    { ".validate": "newData.isString() && newData.val().length === 10" },
        "purpose":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "notes":          { ".validate": "newData.isString() && newData.val().length <= 400" },
        "invoiceUrl":     { ".validate": "newData.isString() && newData.val().length <= 500" },
        "hsn":            { ".validate": "newData.isString() && newData.val().length <= 12" },
        "itcEligibility": { ".validate": "newData.val() === 'eligible' || newData.val() === 'ineligible' || newData.val() === 'capital'" },
        "createdAt":      { ".validate": "newData.isString() && newData.val().length >= 20" },
        "gstRate":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "taxableValue":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "cgst":           { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "sgst":           { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "igst":           { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "cess":           { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalTax":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "amountPaid":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "stockLedger": {
      ".read":  "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      ".write": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$entry": {
        ".validate": "newData.hasChildren(['sku','type','qty','at'])",
        "sku":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "type": { ".validate": "newData.isString() && (newData.val() === 'count' || newData.val() === 'receive' || newData.val() === 'remove')" },
        "qty":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "at":   { ".validate": "newData.isString() && newData.val().length >= 20" },
        "$other": { ".validate": false }
      }
    },

    "reviews": {
      ".read": true,
      "$pid": {
        "$rid": {
          ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) )",
          ".validate": "!newData.exists() || (newData.hasChild('rating') && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5)"
        }
      }
    },

    "experienceReviews": {
      ".read": true,
      "$id": {
        ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || !data.exists() )",
        ".validate": "!newData.exists() || (newData.hasChild('service') && newData.hasChild('packing') && newData.child('service').isNumber() && newData.child('packing').isNumber())"
      }
    },

    "orders": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        "$oid": {
          ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || (auth.uid === $uid && newData.exists()) )",

          "id":       { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "orderNo":  { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "placedAt": { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "userUid":  { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },

          "total":            { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "fee":              { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "amountDue":        { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "couponDiscount":   { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "referralDiscount": { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },
          "loyaltyDiscount":  { ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || !data.exists() || newData.val() === data.val()" },

          "status": {
            ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || newData.val() === 'Awaiting Payment' || newData.val() === 'Payment Review' || newData.val() === 'Cancelled' || (data.exists() && newData.val() === data.val())"
          },
          "paymentStatus": {
            ".validate": "auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2' || newData.val() !== 'Verified' || (data.exists() && newData.val() === data.val())"
          }
        }
      }
    },

    "favorites": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        ".write": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))"
      }
    },

    "abandonedCarts": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        ".write": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        ".validate": "!newData.exists() || (newData.hasChild('updatedAt') && newData.child('updatedAt').isNumber())"
      }
    },

    "interest": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$pid": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "requests": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$id": {
        ".write": "auth != null && (!data.exists() || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))"
      }
    },

    "showcase": {
      ".read": true,
      "$id": {
        ".write": "auth != null && ( !data.exists() || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || auth.uid === data.child('userUid').val() || (data.child('expiresAt').isNumber() && data.child('expiresAt').val() < now) )"
      }
    },

    "analytics": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "total":  { ".write": "auth != null", ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" },
      "daily":  { "$d":    { ".write": "auth != null", ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" } },
      "funnel": { "$step": { ".write": "auth != null", ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" } },
      "events": { "$type": { "$key": { ".write": "auth != null", ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" } } },
      "search": { "$term": { ".write": "auth != null", ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" } }
    },

    "orderSeq": {
      ".read": "auth != null",
      "$day": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
      }
    },

    "loyalty": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || (auth.uid === $uid && newData.child('points').isNumber() && newData.child('points').val() >= 0 && newData.child('points').val() <= (data.exists() ? data.child('points').val() : 0)) )"
      }
    },

    "restock": {
      ".read": "auth != null && (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2')",
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "userrefs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2'))"
      }
    },

    "referrals": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || !data.exists() || data.child('used').val() != true )",
        ".validate": "newData.hasChild('owner') && (!data.exists() || data.child('owner').val() === newData.child('owner').val())",
        "rewardCoins": {
          ".validate": "(auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || newData.val() === (data.exists() ? data.val() : 0)"
        },
        "delivered": {
          ".validate": "(auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || newData.val() === false || (data.exists() && newData.val() === data.val())"
        }
      }
    },

    "testimonials": {
      ".read": true,
      "$id": {
        ".write": "auth != null && ( (auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) )",
        ".validate": "!newData.exists() || (newData.hasChild('uid') && newData.hasChild('text'))",
        "approved": {
          ".validate": "(auth.uid === 'cI2HmMt6FdR7fO7uUnugH85GeZt2') || newData.val() === false"
        }
      }
    },

    "promoUsage": {
      ".read": true,
      "$date": {
        "$type": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())"
        }
      }
    },

    "__ping": { ".read": true, ".write": "auth != null" }
  }
}
