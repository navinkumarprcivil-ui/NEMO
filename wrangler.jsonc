{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nemo-aqua-store",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.nemoaquastore.in",
      "custom_domain": true
    },
    {
      "pattern": "nemoaquastore.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./cf-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://www.nemoaquastore.in",
    "CASHFREE_ENV": "production"
  },
  // Documentation for whoever sets this up next. These are set in the Cloudflare
  // dashboard (Workers & Pages -> nemo-aqua-store -> Settings -> Variables and Secrets),
  // never in this file and never in the repository. They survive every deploy.
  "secrets": {
    "required": [
      "FIREBASE_SERVICE_ACCOUNT",
      "CRON_SECRET",
      "PHONEPE_CLIENT_ID",
      "PHONEPE_CLIENT_SECRET",
      "PHONEPE_CLIENT_VERSION",
      "PHONEPE_WEBHOOK_USERNAME",
      "PHONEPE_WEBHOOK_PASSWORD"
    ]
    // Optional, set the same way when wanted:
    //   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET  (fallback gateway)
    //   PHONEPE_ENV                                                     ("production" to go live)
    // Wrangler rejects unknown keys inside "secrets", so this stays a comment.
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
